# ----- Timezone (usado em todos os contêineres) -----
TZ=America/Sao_Paulo

# ----- Ports (expostos só no host / loopback) -----
NC_HTTP_PORT=8080
OO_HTTP_PORT=8082

# ----- Nextcloud DB -----
NC_DB_ROOT_PASSWORD=CHANGE_ME
NC_DB_NAME=nextcloud
NC_DB_USER=ncuser
NC_DB_PASSWORD=CHANGE_ME

# ----- Volumes (padrão do setup: /data/nextcloud-onlyoffice) -----
NC_DB_VOLUME=/data/nextcloud-onlyoffice/data/nc-db
NC_APP_VOLUME=/data/nextcloud-onlyoffice/data/nc-app
NC_DATA_VOLUME=/data/nextcloud-onlyoffice/data/nextcloud/data

OO_PG_VOLUME=/data/nextcloud-onlyoffice/data/onlyoffice/postgres
OO_DATA_VOLUME=/data/nextcloud-onlyoffice/data/onlyoffice/data
OO_LOGS_VOLUME=/data/nextcloud-onlyoffice/data/onlyoffice/logs
OO_LIB_VOLUME=/data/nextcloud-onlyoffice/data/onlyoffice/lib

# ----- Nextcloud overwrite (LOCAL) -----
NC_OVERWRITE_CLI_URL=https://cloud.mms
NC_OVERWRITE_HOST=cloud.mms
NC_OVERWRITE_PROTOCOL=https

# ----- Nextcloud confiança -----
# Múltiplos domínios separados por vírgula
NC_TRUSTED_DOMAINS=cloud.mms
# Ajuste para o IP do host Docker (ex.: 172.17.0.1) e loopback
NC_TRUSTED_PROXIES=172.17.0.1,127.0.0.1

# ----- OnlyOffice URLs -----
# URL externa (HTTPS via nginx no host)
OO_PUBLIC_URL=https://onlyoffice.mms/

# URL interna docker (HTTP)
OO_INTERNAL_URL=http://onlyoffice/
NC_INTERNAL_URL=http://app/

# ----- OnlyOffice JWT -----
OO_JWT_SECRET=CHANGE_ME_LONG_RANDOM
